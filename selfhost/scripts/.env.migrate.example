# Variáveis para o script migrate-storage.ts
# Copie para .env.migrate e preencha

# === ORIGEM: Supabase Cloud ===
SOURCE_URL=https://vaabpicspdbolvutnscp.supabase.co
SOURCE_SERVICE_KEY=eyJ...service_role_da_cloud

# === DESTINO: Self-hosted (via SSH tunnel ou domínio) ===
TARGET_URL=https://api.suaempresa.com
TARGET_SERVICE_KEY=eyJ...service_role_gerado_no_self_hosted

# Buckets a migrar (vírgula separada). Vazio = todos.
BUCKETS=site_personalizacoes,client-submissions,vitrine-imagens,template-images,Imagens,vendedor-fotos

# Pular arquivos já existentes no destino (idempotente)
SKIP_EXISTING=true
